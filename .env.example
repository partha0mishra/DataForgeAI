# DataForge AI Platform - Environment Configuration
# Copy this file to .env and update with your values

# ============================================
# Core Platform Settings
# ============================================
DATAFORGE_ENV=development
DATAFORGE_LOG_LEVEL=INFO
DATAFORGE_SECRET_KEY=change-me-to-a-random-string
DATAFORGE_TIMEZONE=UTC

# ============================================
# Database Configuration
# ============================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=dataforge
POSTGRES_USER=dataforge
POSTGRES_PASSWORD=changeme

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# GenAI / LLM Configuration
# ============================================
# xAI Grok
XAI_API_KEY=your-xai-api-key-here
XAI_API_BASE_URL=https://api.x.ai/v1

# OpenAI (Fallback)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_ORG_ID=

# Anthropic Claude (Optional)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ============================================
# Cloud Provider Credentials
# ============================================
# AWS
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_DEFAULT_REGION=us-east-1
AWS_S3_BUCKET=dataforge-data

# Azure (Optional)
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=

# GCP (Optional)
GCP_PROJECT_ID=
GCP_SERVICE_ACCOUNT_KEY_PATH=/path/to/service-account.json
GCS_BUCKET=dataforge-data

# ============================================
# Data Warehouse Connections
# ============================================
# Snowflake
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=

# BigQuery
BIGQUERY_PROJECT=
BIGQUERY_DATASET=

# Redshift
REDSHIFT_HOST=
REDSHIFT_PORT=5439
REDSHIFT_DB=
REDSHIFT_USER=
REDSHIFT_PASSWORD=

# ============================================
# Streaming / Message Queue
# ============================================
# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# ============================================
# Airflow Configuration
# ============================================
AIRFLOW_HOME=/opt/airflow
AIRFLOW__CORE__EXECUTOR=CeleryExecutor
AIRFLOW__CORE__SQL_ALCHEMY_CONN=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
AIRFLOW__CELERY__RESULT_BACKEND=db+postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
AIRFLOW__CELERY__BROKER_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0
AIRFLOW__CORE__FERNET_KEY=your-fernet-key-here
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=true
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__WEBSERVER__SECRET_KEY=your-airflow-secret-key

# ============================================
# MLflow Configuration
# ============================================
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_BACKEND_STORE_URI=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/mlflow
MLFLOW_ARTIFACT_ROOT=s3://${AWS_S3_BUCKET}/mlflow-artifacts

# ============================================
# Monitoring & Observability
# ============================================
# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=dataforge-platform

# Prometheus
PROMETHEUS_ENDPOINT=http://prometheus:9090

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ============================================
# Vector Database (Milvus)
# ============================================
MILVUS_HOST=milvus
MILVUS_PORT=19530

# ============================================
# Authentication & Authorization
# ============================================
AUTH_ENABLED=true
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# OAuth (Optional)
OAUTH_PROVIDER=okta
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_DOMAIN=

# ============================================
# Data Catalog
# ============================================
DATAHUB_GMS_HOST=datahub-gms
DATAHUB_GMS_PORT=8080

# ============================================
# BI / Dashboarding
# ============================================
SUPERSET_SECRET_KEY=your-superset-secret-key
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin

# ============================================
# Feature Flags
# ============================================
ENABLE_DATA_QUALITY_CHECKS=true
ENABLE_GENAI_FEATURES=true
ENABLE_MONETIZATION=false
ENABLE_PROCESS_OPTIMIZATION=false

# ============================================
# Resource Limits
# ============================================
MAX_CONCURRENT_PIPELINES=10
SPARK_DRIVER_MEMORY=4g
SPARK_EXECUTOR_MEMORY=8g
SPARK_EXECUTOR_CORES=4

# ============================================
# Security
# ============================================
ENCRYPTION_AT_REST=true
ENCRYPTION_KEY_ARN=arn:aws:kms:us-east-1:123456789:key/your-key-id
ENABLE_AUDIT_LOGGING=true

# ============================================
# Cost Management
# ============================================
ENABLE_COST_TRACKING=true
COST_ALLOCATION_TAGS=project,environment,team

# ============================================
# Development / Debug
# ============================================
DEBUG_MODE=false
ENABLE_PROFILING=false
LOG_SQL_QUERIES=false
