# Dockerfile for API-Only Mode
# Compatible with DataForge shared libraries (Pydantic v2, SQLAlchemy 2.0)

FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    libpq-dev \
    git \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY requirements-api.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements-api.txt

# Copy shared libraries (install as editable)
COPY ../../shared/common /app/shared/common
COPY ../../shared/connectors /app/shared/connectors

# Install shared libraries
RUN pip install -e /app/shared/common
RUN pip install -e /app/shared/connectors

# Copy API application
COPY api/ ./api/

# Set environment variables
ENV PYTHONPATH=/app
ENV DATAFORGE_ENV=production
ENV LOG_LEVEL=INFO

EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:8000/health')"

# Run API server
CMD ["uvicorn", "api.src.main:app", "--host", "0.0.0.0", "--port", "8000"]
