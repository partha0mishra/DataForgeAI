# Database Configuration
DATABASE_URL=postgresql://dataforge:dataforge@localhost:5432/mlops_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# MLflow Configuration
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_ARTIFACT_ROOT=s3://mlflow-artifacts
MLFLOW_S3_BUCKET=mlflow-artifacts

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600

# Security
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# API Configuration
API_V1_PREFIX=/api/v1
DEBUG=false
LOG_LEVEL=INFO

# AWS Configuration (for S3 artifacts)
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_REGION=us-east-1

# Deployment Configuration
DEPLOYMENT_NAMESPACE=production
KUBERNETES_CLUSTER_URL=https://kubernetes.default.svc
