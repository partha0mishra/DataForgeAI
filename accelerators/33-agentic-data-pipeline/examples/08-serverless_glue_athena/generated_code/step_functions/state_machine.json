{
  "Comment": "Serverless Glue + Athena Data Pipeline",
  "StartAt": "StartGlueCrawler",
  "States": {
    "StartGlueCrawler": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:glue:startCrawler",
      "Parameters": {
        "Name": "data-lake-crawler"
      },
      "Next": "WaitForCrawler",
      "Catch": [{
        "ErrorEquals": ["Glue.CrawlerRunningException"],
        "Next": "WaitForCrawler"
      }]
    },
    "WaitForCrawler": {
      "Type": "Wait",
      "Seconds": 30,
      "Next": "GetCrawlerStatus"
    },
    "GetCrawlerStatus": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:glue:getCrawler",
      "Parameters": {
        "Name": "data-lake-crawler"
      },
      "Next": "CheckCrawlerStatus"
    },
    "CheckCrawlerStatus": {
      "Type": "Choice",
      "Choices": [{
        "Variable": "$.Crawler.State",
        "StringEquals": "READY",
        "Next": "StartGlueJob"
      }],
      "Default": "WaitForCrawler"
    },
    "StartGlueJob": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "process-sales-data",
        "Arguments": {
          "--SOURCE_PATH": "s3://your-data-lake/raw/sales/",
          "--TARGET_PATH": "s3://your-data-lake/processed/sales/"
        }
      },
      "Next": "RunAthenaQuery"
    },
    "RunAthenaQuery": {
      "Type": "Task",
      "Resource": "arn:aws:states:::athena:startQueryExecution.sync",
      "Parameters": {
        "QueryString": "MSCK REPAIR TABLE data_lake.sales_processed",
        "WorkGroup": "data-analytics",
        "ResultConfiguration": {
          "OutputLocation": "s3://your-data-lake/athena-results/"
        }
      },
      "Next": "Success"
    },
    "Success": {
      "Type": "Succeed"
    }
  }
}
