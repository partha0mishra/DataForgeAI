{
  "id": "shopify-dlt-pipeline",
  "name": "Shopify Orders Delta Live Tables Pipeline",
  "storage": "s3://your-bucket/dlt/shopify",
  "configuration": {
    "shopify.store_url": "your-store.myshopify.com",
    "shopify.secret_scope": "shopify_api"
  },
  "clusters": [
    {
      "label": "default",
      "autoscale": {
        "min_workers": 1,
        "max_workers": 5,
        "mode": "ENHANCED"
      },
      "node_type_id": "i3.xlarge",
      "spark_conf": {
        "spark.databricks.delta.optimizeWrite.enabled": "true",
        "spark.databricks.delta.autoCompact.enabled": "true"
      }
    }
  ],
  "libraries": [
    {
      "pypi": {
        "package": "requests>=2.31.0"
      }
    }
  ],
  "target": "shopify_analytics",
  "continuous": true,
  "development": false,
  "photon": true,
  "catalog": "shopify_analytics",
  "channel": "CURRENT"
}
